#!/usr/bin/env bash
set -euo pipefail

# Replaced by the release workflow at packaging time
# (sed -i "s/__VERSION__/${GITHUB_REF_NAME#v}/" on the packaged copy).
# When unreplaced (local dev / git clone), `--version` reports "dev".
VERSION="__VERSION__"

# Keep long-running SSH streams alive across idle NAT/firewall timeouts and
# detect dead peers instead of hanging forever.
SSH_OPTS=(-o ServerAliveInterval=30 -o ServerAliveCountMax=6)

usage() {
  cat <<'EOF'
Usage:
  dir-backup archive [--compression gzip|zstd] [--extract [--remap OLD_PREFIX:NEW_PREFIX] [--dest /remote_dir]] [--owner OWNER] [--group GROUP] <output> <abs_path1> [<abs_path2> ...]
  dir-backup unarchive [--progress] [--keep-old-files] [--download /local/file [--retries N] [--rm-download]] [--remap OLD_PREFIX:NEW_PREFIX] [--exclude-folder NAME]... <archive.tar.gz | user@host:/abs/path/file.tar.gz> [<dest_dir>]
  dir-backup --version | -V | version

Notes:
  - `archive` packs one or more local files or directories into a .tar.gz.
  - `archive` requires absolute source paths.
  - `--compression` selects gzip (default) or zstd; it applies to `archive`
    only. `unarchive` detects the format automatically. `zstd` must be installed
    locally, and on the remote when using `--extract`.
  - <output> is local when absolute (/path.tar.gz), remote when a remote-spec
    (user@host:/path.tar.gz). A leading "/" always means local.
  - A remote <output> streams over SSH and writes the raw .tar.gz remotely.
  - `--extract` (remote only) extracts the stream remotely instead of writing
    the archive file; archive paths are relative to / (absolute restore).
  - `--extract --dest /remote_dir` extracts relative to that remote directory.
  - `--extract --remap OLD:NEW` rewrites a path prefix at extraction time.
  - `--owner`/`--group` force ownership when extracting remotely.
  - `unarchive` without <dest_dir> restores to original absolute paths.
  - `unarchive` with <dest_dir> extracts relative to that directory.
  - `unarchive --remap` rewrites a path prefix at extraction time (e.g. /home/nparis:/home/parisni).
  - `unarchive` streams the archive over SSH when the source is `user@host:/abs/path`; nothing is downloaded to disk.
    The compressed bytes are transferred and decompressed locally (`zstd` must be installed locally for zstd archives).
  - SSH connections use keepalives (ServerAliveInterval=30, ServerAliveCountMax=6).
  - `unarchive --progress` shows a transfer progress bar via `pv` (requires `pv` to be installed; e.g. `apt-get install pv`).
  - `unarchive --keep-old-files` never overwrites files that already exist (tar -k); useful to resume an interrupted restore.
  - `unarchive --download /local/file` (remote source only) first copies the archive locally with
    `rsync --partial` (resumable, retried up to `--retries N` times on network errors, default 5),
    then extracts the local copy. The copy is kept unless `--rm-download` is given. Requires rsync on both sides.
  - `unarchive --exclude-folder NAME` skips any directory whose basename equals NAME, at any depth (literal name, no globs). Repeatable.
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

is_abs_path() {
  [[ "$1" == /* ]]
}

parse_remote() {
  local input="$1"
  [[ "$input" == *:* ]] || return 1
  local host_part="${input%%:*}"
  local path_part="${input#*:}"
  [[ -n "$host_part" ]] || return 1
  [[ -n "$path_part" ]] || return 1
  printf '%s\n%s\n' "$host_part" "$path_part"
}

shell_quote() {
  local s="$1"
  printf "'%s'" "${s//\'/\'\"\'\"\'}"
}

# file_size <path> -> prints the size in bytes (GNU stat, then BSD/macOS stat).
file_size() {
  stat -c %s -- "$1" 2>/dev/null || stat -f %z -- "$1" 2>/dev/null
}

# download_remote <host> <remote_path> <local_path> <retries>
# Resumable copy via rsync --partial; retries on network/transfer errors.
download_remote() {
  local host="$1" rpath="$2" lpath="$3" retries="$4"
  local attempt=0 rc
  while :; do
    if rsync --partial --progress -e "ssh ${SSH_OPTS[*]}" -- "${host}:${rpath}" "$lpath"; then
      return 0
    else
      rc=$?
    fi
    case "$rc" in
      10|11|12|23|30|35|255) ;;
      *) die "rsync failed (exit $rc)" ;;
    esac
    attempt=$((attempt + 1))
    [[ "$attempt" -le "$retries" ]] || die "rsync failed (exit $rc) after $retries retries"
    echo "rsync interrupted (exit $rc); retry $attempt/$retries in 10s..." >&2
    sleep 10
  done
}

cmd_archive() {
  local do_extract=0
  local remap=""
  local dest_dir=""
  local force_owner=""
  local force_group=""
  local compression="gzip"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --extract)
        do_extract=1
        shift
        ;;
      --remap)
        [[ $# -ge 2 ]] || die "--remap requires a value"
        remap="$2"
        shift 2
        ;;
      --dest)
        [[ $# -ge 2 ]] || die "--dest requires a value"
        dest_dir="$2"
        shift 2
        ;;
      --compression)
        [[ $# -ge 2 ]] || die "--compression requires a value (gzip or zstd)"
        compression="$2"
        shift 2
        ;;
      --owner)
        [[ $# -ge 2 ]] || die "--owner requires a value"
        force_owner="$2"
        shift 2
        ;;
      --group)
        [[ $# -ge 2 ]] || die "--group requires a value"
        force_group="$2"
        shift 2
        ;;
      --) shift; break ;;
      -*) die "unknown archive option: $1" ;;
      *)  break ;;
    esac
  done

  [[ $# -ge 2 ]] || die "archive expects: <output> <abs_path1> [<abs_path2> ...]"

  local output="$1"
  shift

  local path
  for path in "$@"; do
    is_abs_path "$path" || die "source path must be absolute: $path"
    [[ -e "$path" ]]    || die "source path does not exist: $path"
  done

  # Strip leading / to get paths relative to /, enabling --transform at extraction time
  local rel_paths=()
  for path in "$@"; do
    rel_paths+=("${path#/}")
  done

  # Pick the tar compression flag from --compression. Local `unarchive` uses
  # tar's autodetection, but a streamed remote extract cannot autodetect from a
  # pipe, so the flag is also passed explicitly on the remote side below.
  local tar_compress_flag
  case "$compression" in
    gzip) tar_compress_flag="-z" ;;
    zstd)
      tar_compress_flag="--zstd"
      # zstd must be available locally to compress the stream.
      command -v zstd >/dev/null 2>&1 || die "zstd not found in PATH (required for --compression zstd)"
      ;;
    *) die "unknown compression: $compression (expected gzip or zstd)" ;;
  esac

  # Infer remote vs local from <output>: a leading "/" is always local; otherwise
  # accept the scp-style remote-spec [user@]host:/abs/path (host + absolute path).
  if is_abs_path "$output"; then
    [[ "$do_extract" -eq 0 ]] || die "--extract requires a remote output (use unarchive for local extraction)"
    [[ -z "$remap" ]]         || die "--remap requires --extract (remote only)"
    [[ -z "$dest_dir" ]]      || die "--dest requires --extract (remote only)"
    [[ -z "$force_owner" && -z "$force_group" ]] || die "--owner/--group require --extract (remote only)"

    echo "Archiving $# item(s) to '$output'..."
    tar -c "$tar_compress_flag" -f "$output" -C / "${rel_paths[@]}"
    echo "Archive complete."
    return
  fi

  local parsed
  parsed="$(parse_remote "$output")" || die "output must be a local absolute path or a remote-spec user@host:/absolute/path"

  local remote_host
  local remote_path
  remote_host="$(printf '%s' "$parsed" | sed -n '1p')"
  remote_path="$(printf '%s' "$parsed" | sed -n '2p')"

  is_abs_path "$remote_path" || die "remote path must be absolute: $remote_path"

  if [[ "$do_extract" -eq 0 ]]; then
    [[ -z "$remap" ]]    || die "--remap requires --extract"
    [[ -z "$dest_dir" ]] || die "--dest requires --extract"
    [[ -z "$force_owner" && -z "$force_group" ]] || die "--owner/--group require --extract"

    echo "Streaming archive of $# item(s) to '$remote_host:$remote_path'..."
    # Deposit the raw archive remotely; no local copy is written. The remote only
    # runs `cat`, so it needs no decompressor here regardless of --compression.
    tar -c "$tar_compress_flag" -f - -C / "${rel_paths[@]}" \
      | ssh "${SSH_OPTS[@]}" "$remote_host" "cat > $(shell_quote "$remote_path")"
    echo "Archive complete."
    return
  fi

  # --extract: stream and extract remotely using unarchive semantics.
  local transform_arg=""
  if [[ -n "$remap" ]]; then
    [[ "$remap" == *:* ]] || die "--remap value must be in form OLD_PREFIX:NEW_PREFIX"
    local remap_old="${remap%%:*}"
    local remap_new="${remap#*:}"
    # Strip leading / since tar strips it before applying --transform
    remap_old="${remap_old#/}"
    remap_new="${remap_new#/}"
    transform_arg=" --transform=$(shell_quote "s|^${remap_old}|${remap_new}|")"
  fi

  local owner_group_args=""
  if [[ -n "$force_owner" ]]; then
    owner_group_args+=" --owner=$(shell_quote "$force_owner")"
  fi
  if [[ -n "$force_group" ]]; then
    owner_group_args+=" --group=$(shell_quote "$force_group")"
  fi

  # When --dest is given, extract relative to it; otherwise restore to / (paths
  # are stored relative to /, mirroring `unarchive` without <dest_dir>).
  local target="/"
  if [[ -n "$dest_dir" ]]; then
    is_abs_path "$dest_dir" || die "--dest must be absolute: $dest_dir"
    target="$dest_dir"
  fi

  echo "Streaming and extracting $# item(s) into '$remote_host:$target'..."
  # tar autodetects compression only for seekable files; reading from a pipe it
  # does not, so the remote must be told the format explicitly. When using zstd,
  # also guard that the remote has the zstd binary tar will shell out to.
  local remote_guard=""
  if [[ "$compression" == "zstd" ]]; then
    remote_guard="command -v zstd >/dev/null 2>&1 || { echo 'Error: zstd not found in remote PATH (required for --compression zstd)' >&2; exit 1; }; "
  fi
  local remote_cmd
  remote_cmd="${remote_guard}mkdir -p $(shell_quote "$target") && tar -x ${tar_compress_flag} -pf -${transform_arg} -C $(shell_quote "$target")${owner_group_args}"
  tar -c "$tar_compress_flag" -f - -C / "${rel_paths[@]}" \
    | ssh "${SSH_OPTS[@]}" "$remote_host" "$remote_cmd"
  echo "Extraction complete."
}

# tar can only autodetect the compression format from a seekable file, not from a
# pipe. For streamed extractions we therefore sniff the magic bytes on the side
# that holds the seekable file and pick the matching decompressor, then feed an
# uncompressed tar stream into `tar -xf -`. `gzip`/`zstd` magic: 1f8b / 28b52ffd.
#
# magic_cmd <quoted_path> -> emits a shell snippet printing the first 4 bytes of
# <quoted_path> as hex. Portable enough to run locally (eval) or over ssh.
magic_cmd() {
  local qpath="$1"
  printf '%s' "head -c 4 -- ${qpath} | od -An -tx1 | tr -d ' \\n'"
}

# decompressor_for_magic <hex> -> prints the decompressor command (gzip -dc,
# zstd -dc or cat) matching the magic bytes, one word per line.
decompressor_for_magic() {
  case "$1" in
    1f8b*) printf '%s\n' gzip -dc ;;
    28b52ffd*) printf '%s\n' zstd -dc ;;
    *) printf '%s\n' cat ;;
  esac
}

cmd_unarchive() {
  local remap=""
  local progress=0
  local keep_old=0
  local download=""
  local retries=5
  local rm_download=0
  # Repeatable flag: each entry is a literal folder name to exclude at any depth.
  local -a exclude_folders=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remap)
        [[ $# -ge 2 ]] || die "--remap requires a value"
        remap="$2"
        shift 2
        ;;
      --progress)
        progress=1
        shift
        ;;
      --keep-old-files)
        keep_old=1
        shift
        ;;
      --download)
        [[ $# -ge 2 ]] || die "--download requires a value"
        download="$2"
        shift 2
        ;;
      --retries)
        [[ $# -ge 2 ]] || die "--retries requires a value"
        retries="$2"
        [[ "$retries" =~ ^[0-9]+$ ]] || die "--retries must be a non-negative integer: $retries"
        shift 2
        ;;
      --rm-download)
        rm_download=1
        shift
        ;;
      --exclude-folder)
        [[ $# -ge 2 ]] || die "--exclude-folder requires a value"
        local ef="$2"
        [[ -n "$ef" ]] || die "--exclude-folder value must not be empty"
        # Enforce literal folder name: reject path separators and tar glob metachars
        # so the contract stays "a folder name" rather than "a tar pattern".
        [[ "$ef" != */* ]] || die "--exclude-folder takes a folder name, not a path: $ef"
        [[ "$ef" != *[\*\?\[]* ]] || die "--exclude-folder takes a folder name, not a pattern: $ef"
        exclude_folders+=("$ef")
        shift 2
        ;;
      --) shift; break ;;
      -*) die "unknown unarchive option: $1" ;;
      *)  break ;;
    esac
  done

  [[ $# -ge 1 && $# -le 2 ]] || die "unarchive expects: [--progress] [--keep-old-files] [--download /local/file [--retries N] [--rm-download]] [--remap OLD:NEW] [--exclude-folder NAME]... <archive.tar.gz | user@host:/abs/path/file.tar.gz> [<dest_dir>]"

  local archive="$1"

  # Detect remote source (user@host:/abs/path) vs local file. Remote sources are
  # streamed over SSH and never written to local disk.
  local remote_host=""
  local remote_path=""
  local parsed
  if parsed="$(parse_remote "$archive")"; then
    remote_host="$(printf '%s' "$parsed" | sed -n '1p')"
    remote_path="$(printf '%s' "$parsed" | sed -n '2p')"
    is_abs_path "$remote_path" || die "remote archive path must be absolute: $remote_path"
  else
    is_abs_path "$archive" || die "archive path must be absolute: $archive"
    [[ -e "$archive" ]]    || die "archive does not exist: $archive"
    [[ -f "$archive" ]]    || die "archive path must be a regular file: $archive"
  fi

  if [[ -n "$download" ]]; then
    [[ -n "$remote_host" ]] || die "--download requires a remote archive (user@host:/abs/path)"
    is_abs_path "$download" || die "--download path must be absolute: $download"
    [[ ! -d "$download" ]]  || die "--download must be a file path, not a directory: $download"
    [[ -d "$(dirname -- "$download")" ]] || die "--download parent directory does not exist: $download"
    command -v rsync >/dev/null 2>&1 || die "--download requires rsync locally"
    ssh "${SSH_OPTS[@]}" "$remote_host" "command -v rsync >/dev/null 2>&1" \
      || die "--download requires rsync on the remote: $remote_host"
  else
    [[ "$rm_download" -eq 0 ]] || die "--rm-download requires --download"
  fi

  # --progress relies on `pv` (https://www.ivarch.com/programs/pv.shtml) to render
  # a real progress bar with ETA. We require both `pv` and a known byte size so
  # the bar is meaningful; otherwise we fail fast rather than degrade silently.
  if [[ "$progress" -eq 1 ]]; then
    command -v pv >/dev/null 2>&1 || die "--progress requires pv (e.g. apt-get install pv)"
  fi

  local extract_dir
  if [[ $# -eq 2 ]]; then
    extract_dir="$2"
    is_abs_path "$extract_dir" || die "dest_dir must be absolute: $extract_dir"
    [[ -e "$extract_dir" ]]   || die "dest_dir does not exist: $extract_dir"
    [[ -d "$extract_dir" ]]   || die "dest_dir must be a directory: $extract_dir"
  else
    # Archive stores paths relative to /; extract to / restores absolute locations
    extract_dir="/"
  fi

  # --download: copy the remote archive locally first (resumable), then extract
  # it as a local archive.
  if [[ -n "$download" ]]; then
    echo "Downloading '$archive' to '$download'..."
    download_remote "$remote_host" "$remote_path" "$download" "$retries"
    archive="$download"
    remote_host=""
    remote_path=""
  fi

  local archive_size=""
  if [[ "$progress" -eq 1 ]]; then
    if [[ -n "$remote_host" ]]; then
      archive_size="$(ssh "${SSH_OPTS[@]}" "$remote_host" "stat -c %s -- $(shell_quote "$remote_path")" 2>/dev/null)" \
        || die "could not stat remote archive: $remote_host:$remote_path"
    else
      archive_size="$(file_size "$archive")" \
        || die "could not stat local archive: $archive"
    fi
    [[ "$archive_size" =~ ^[0-9]+$ ]] || die "could not determine archive size for --progress"
  fi

  local transform_arg=""
  if [[ -n "$remap" ]]; then
    [[ "$remap" == *:* ]] || die "--remap value must be in form OLD_PREFIX:NEW_PREFIX"
    local remap_old="${remap%%:*}"
    local remap_new="${remap#*:}"
    # Strip leading / since tar strips it before applying --transform
    remap_old="${remap_old#/}"
    remap_new="${remap_new#/}"
    transform_arg="--transform=s|^${remap_old}|${remap_new}|"
  fi

  # Build tar exclude args: for each folder name, exclude both the top-level
  # entry and any nested occurrence. tar applies excludes recursively to
  # matched directories, so this skips the whole subtree.
  local -a exclude_args=()
  local name
  for name in "${exclude_folders[@]}"; do
    exclude_args+=("--exclude=$name" "--exclude=*/$name")
  done

  local -a tar_args=()
  if [[ -n "$transform_arg" ]]; then
    tar_args+=("$transform_arg")
  fi
  tar_args+=("${exclude_args[@]}")
  if [[ "$keep_old" -eq 1 ]]; then
    tar_args+=(-k)
  fi

  if [[ $# -eq 2 ]]; then
    echo "Extracting '$archive' into '$extract_dir'..."
  else
    echo "Extracting '$archive' to original paths..."
  fi

  if [[ -n "$remote_host" ]]; then
    # Stream the compressed archive bytes over SSH and decompress locally;
    # nothing is written to disk. The remote holds the seekable file, so the
    # format is sniffed there first (tar cannot autodetect from a pipe).
    local qremote magic
    qremote="$(shell_quote "$remote_path")"
    magic="$(ssh "${SSH_OPTS[@]}" "$remote_host" "$(magic_cmd "$qremote")")" \
      || die "could not read remote archive: $remote_host:$remote_path"
    local -a local_decompress
    mapfile -t local_decompress < <(decompressor_for_magic "$magic")
    command -v "${local_decompress[0]}" >/dev/null 2>&1 \
      || die "${local_decompress[0]} not found in PATH (required to decompress the archive locally)"
    if [[ "$progress" -eq 1 ]]; then
      ssh "${SSH_OPTS[@]}" "$remote_host" "cat -- $qremote" \
        | pv -s "$archive_size" \
        | "${local_decompress[@]}" \
        | tar "${tar_args[@]}" -xf - -C "$extract_dir"
    else
      ssh "${SSH_OPTS[@]}" "$remote_host" "cat -- $qremote" \
        | "${local_decompress[@]}" \
        | tar "${tar_args[@]}" -xf - -C "$extract_dir"
    fi
  else
    if [[ "$progress" -eq 1 ]]; then
      # pv measures the compressed file, so decompress explicitly (sniffed from
      # the seekable file) before tar, which cannot autodetect from a pipe.
      local -a local_decompress
      mapfile -t local_decompress < <(decompressor_for_magic "$(eval "$(magic_cmd "$(shell_quote "$archive")")")")
      command -v "${local_decompress[0]}" >/dev/null 2>&1 \
        || die "${local_decompress[0]} not found in PATH (required to decompress the archive)"
      pv -s "$archive_size" -- "$archive" \
        | "${local_decompress[@]}" \
        | tar "${tar_args[@]}" -xf - -C "$extract_dir"
    else
      # Local seekable file: tar autodetects gzip/zstd on its own.
      tar "${tar_args[@]}" -xf "$archive" -C "$extract_dir"
    fi
  fi

  if [[ "$rm_download" -eq 1 ]]; then
    rm -f -- "$download"
    echo "Removed downloaded archive '$download'."
  fi

  echo "Extraction complete."
}

main() {
  [[ $# -gt 0 ]] || {
    usage
    exit 1
  }

  local subcmd="$1"
  shift

  case "$subcmd" in
    archive)
      cmd_archive "$@"
      ;;
    unarchive)
      cmd_unarchive "$@"
      ;;
    --version|-V|version)
      # When unreplaced (local dev / git clone), the placeholder is shown as "dev"
      # so users can tell they are not on a released build. The sentinel is
      # reassembled at runtime so the release workflow's sed does not rewrite
      # this comparison branch (which would otherwise always be true and
      # always print "dev").
      placeholder="__""VERSION""__"
      if [[ "$VERSION" == "$placeholder" ]]; then
        printf 'dir-backup dev\n'
      else
        printf 'dir-backup %s\n' "$VERSION"
      fi
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die "unknown subcommand: $subcmd"
      ;;
  esac
}

main "$@"
